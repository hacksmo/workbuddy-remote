# nginx 反代示例 —— 放在中转服务器上
#
# 作用：把 https://<你的域名>/ 反代到反向 SSH 隧道在 127.0.0.1 开的端口。
#
# 安装：
#   1. 把域名 A 记录指向这台服务器（Cloudflare 请用「仅 DNS / 灰云」）
#   2. 把下面的 your.domain 和 18797 换成实际值
#   3. cp 到 /etc/nginx/conf.d/workbuddy.conf && nginx -t && systemctl reload nginx
#   4. 证书：certbot --webroot -w /var/www/certbot -d your.domain
#
# ⚠️ 必须用灰云（DNS only）。开橙云（Cloudflare 代理）会缓冲 SSE，
#    实时消息推送失效，大文件上传也会被卡。

map $http_upgrade $wb_conn {
    default upgrade;
    ''      close;
}

# 上游连接池。走 SSH 隧道时新建 TCP 连接要额外经本机一次往返，
# 一个页面要拉 6+ 个资源，不复用会明显变慢。
upstream workbuddy_backend {
    server 127.0.0.1:18797;
    keepalive 32;
    keepalive_timeout 75s;
    keepalive_requests 1000;
}

server {
    listen 80;
    server_name your.domain;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name your.domain;

    ssl_certificate     /etc/letsencrypt/live/your.domain/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your.domain/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:WB:10m;
    ssl_session_timeout 1d;

    # 关掉缓冲，SSE 才能实时推送
    proxy_buffering off;
    proxy_request_buffering off;

    client_max_body_size 64m;

    location / {
        proxy_pass http://workbuddy_backend;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Connection 头只能设一次，由 $wb_conn 决定：
        #   普通请求 → 空值，上游保活可复用
        #   SSE/WS   → upgrade
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $wb_conn;

        proxy_read_timeout     3600s;
        proxy_send_timeout     3600s;
        proxy_connect_timeout  10s;
    }
}